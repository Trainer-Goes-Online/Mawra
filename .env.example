# ============================================================
# Mawra Ishaque — paid funnel
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# Restart `npm run dev` after any change.
# ============================================================

# ------------------------------------------------------------
# 1) RAZORPAY — payment gateway (REQUIRED for the paid checkout)
# ------------------------------------------------------------
# Get these from: Razorpay Dashboard → Settings → API Keys → Generate Key.
# Use the rzp_test_* pair while testing; swap to rzp_live_* when going live.
#
# NOTE: a key id starting with `rzp_test_` marks every order as a test order —
# it is flagged is_test=true in the Pabbly payload and is skipped for Meta CAPI,
# so QA payments never pollute the ads algorithm.

# Public key id — safe to expose, it is sent to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Secret key — SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Amount actually charged, in paise. 9700 = ₹97.
RAZORPAY_AMOUNT_PAISE=9700

# Struck-through "was" price shown next to the live price, in paise.
# 99900 = ₹999. Display only — it is never charged.
RAZORPAY_MRP_PAISE=99900

# Currency code for the order.
RAZORPAY_CURRENCY=INR


# ------------------------------------------------------------
# 2) PABBLY — post-payment webhook (REQUIRED)
# ------------------------------------------------------------
# Fired from /api/razorpay/verify ONLY after the Razorpay signature is verified.
# Carries the full payload: customer details, payment ids, amount, all UTMs,
# gclid/fbclid, fbp/fbc cookies, IP, user agent and the booking url.
# Create a Pabbly Connect workflow → trigger "Webhook" → paste its URL here.
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/workflow/sendwebhookdata/xxxxxxxx


# ------------------------------------------------------------
# 3) CALENDLY — the booking step after payment (REQUIRED)
# ------------------------------------------------------------
# Mawra's scheduling link for the 1:1 diagnostic call.
# Configure its intake questions per docs/calendly-intake-questions.md.
# Leave the event's own confirmation page as the Calendly default (no redirect) —
# the embed forwards to /thank-you itself.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/your-event


# ------------------------------------------------------------
# 4) LEAD WEBHOOK — pre-payment lead capture (optional)
# ------------------------------------------------------------
# Used by /api/lead. In the paid funnel the checkout form is the lead capture,
# so this is only needed if the free lead modal is still in use anywhere.
LEAD_WEBHOOK_URL=


# ------------------------------------------------------------
# 5) ANALYTICS + META ADS (optional, but recommended for ad tracking)
# ------------------------------------------------------------
# Google Analytics 4 measurement id. Nothing loads if blank.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project id. Nothing loads if blank.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel + Conversions API. Both must be set for server-side CAPI to fire.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Meta test event code — set only while validating in Events Manager, then clear.
META_TEST_EVENT_CODE=

# Meta event name overrides. Leave blank to use the built-in defaults.
ATC_STANDARD_EVENT=
ATC_CUSTOM_EVENT=
SCHEDULE_STANDARD_EVENT=
SCHEDULE_CUSTOM_EVENT=
FREE_STANDARD_EVENT=
FREE_CUSTOM_EVENT=
QUALIFIED_EVENT=
